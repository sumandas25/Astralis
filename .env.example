# Supabase client settings
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Server-side Supabase settings
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Research AI provider settings
# Choose one provider. Keep these server-side only; never prefix them with VITE_.
# AI_PROVIDER is optional. Supported values: openai, gemini, lovable, custom.
AI_PROVIDER=openai

# Option A: OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Option B: Gemini through Google's OpenAI-compatible endpoint
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Option C: Lovable AI Gateway
LOVABLE_API_KEY=your-lovable-api-key
LOVABLE_MODEL=google/gemini-3-flash-preview

# Option D: Any OpenAI-compatible provider
AI_API_KEY=your-provider-api-key
AI_BASE_URL=https://your-provider.example/v1
AI_MODEL=gpt-4o-mini
